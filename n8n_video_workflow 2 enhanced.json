    {
      "parameters": {
        "jsCode": "// Set default services if not specified\nif (!$input.all()[0].json.video_service) {\n  $input.all()[0].json.video_service = 'veo3'; // Default video service\n}\n\nif (!$input.all()[0].json.tts_service) {\n  $input.all()[0].json.tts_service = 'openai'; // Default TTS service  \n}\n\n// Extract video prompt from AI agent response\nconst aiResponse = $input.all()[0].json.choices[0].message.content;\nconst promptMatch = aiResponse.match(/Video Prompt: (.*?)(?:\\n|$)/i);\n$input.all()[0].json.video_prompt = promptMatch ? promptMatch[1] : aiResponse;\n\n// Extract script content\nconst scriptMatch = aiResponse.match(/Script: (.*?)(?:\\n|$)/i);\n$input.all()[0].json.script_content = scriptMatch ? scriptMatch[1] : 'Generated video content';\n\nreturn $input.all();"
      },
