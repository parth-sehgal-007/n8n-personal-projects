      "parameters": {
        "jsCode": "// Trending controversial topics with high search volume\nconst trendingTopics = [\n  \"AI replacing jobs 2024\",\n  \"Celebrity scandal exposed\",\n  \"Government conspiracy theories\",\n  \"Social media addiction danger\",\n  \"Climate change debate\",\n  \"Cryptocurrency crash prediction\",\n  \"Tech billionaire controversy\",\n  \"Political election fraud claims\",\n  \"Vaccine side effects debate\",\n  \"UFO government disclosure\",\n  \"Fast fashion environmental impact\",\n  \"Social credit system coming\",\n  \"Big tech censorship exposed\",\n  \"Economic collapse warning\",\n  \"Celebrity death hoax\"\n];\n\nconst randomTopic = trendingTopics[Math.floor(Math.random() * trendingTopics.length)];\n\nreturn {\n  selectedTopic: randomTopic,\n  timestamp: new Date().toISOString()\n};"
      },
