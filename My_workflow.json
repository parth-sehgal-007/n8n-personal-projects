    {
      "parameters": {
        "jsCode": "// Combine audio and video using FFmpeg command\nconst ffmpegCommand = {\n  inputs: [\n    { path: $('Video Generation').item.json.output_url },\n    { path: $('Voice Generation').item.binary.data }\n  ],\n  output: `final_video_${Date.now()}.mp4`,\n  options: [\n    '-c:v copy',\n    '-c:a aac',\n    '-map 0:v:0',\n    '-map 1:a:0',\n    '-shortest'\n  ]\n};\n\nreturn {\n  ffmpegCommand,\n  videoReady: true,\n  timestamp: new Date().toISOString()\n};"
      },
