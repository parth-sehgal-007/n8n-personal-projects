        1500,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract title from SEO generator response\nconst seoContent = $('SEO Generator').item.json.choices[0].message.content;\nconst titles = seoContent.match(/\\d+\\..+/g) || [];\nconst selectedTitle = titles[0] ? titles[0].replace(/^\\d+\\.\\s*/, '') : 'Controversial Topic Exposed';\n\n// Create thumbnail prompt\nconst thumbnailPrompt = `Create a YouTube thumbnail for: \"${selectedTitle}\". Style: Bold text overlay, shocked expression, red arrows, dramatic lighting, controversy theme, high contrast colors, clickbait style but professional quality.`;\n\nreturn {\n  thumbnailPrompt,\n  selectedTitle,\n  timestamp: new Date().toISOString()\n};"
      },
