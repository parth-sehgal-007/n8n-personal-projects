            },
            {
              "name": "model",
              "value": "gen3a_turbo"
            },
            {
              "name": "duration",
              "value": "600"
            }
          ]
        }
      },
      "id": "video-generation",
      "name": "Video Generation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Combine audio and video using FFmpeg command\nconst ffmpegCommand = {\n  inputs: [\n    { path: $('Video Generation').item.json.output_url },\n    { path: $('Voice Generation').item.binary.data }\n  ],\n  output: `final_video_${Date.now()}.mp4`,\n  options: [\n    '-c:v copy',\n    '-c:a aac',\n    '-map 0:v:0',\n    '-map 1:a:0',\n    '-shortest'\n  ]\n};\n\nreturn {\n  ffmpegCommand,\n  videoReady: true,\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "video-processing",
      "name": "Video Processing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        380
      ]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Thumbnail Prep').item.json.selectedTitle }}",
        "description": "={{ $('SEO Generator').item.json.choices[0].message.content.split('Description:')[1].split('Hashtags:')[0].trim() }}",
        "tags": "={{ $('SEO Generator').item.json.choices[0].message.content.split('Hashtags:')[1] ? $('SEO Generator').item.json.choices[0].message.content.split('Hashtags:')[1].split('#').slice(1, 11).map(tag => tag.trim().split(' ')[0]).join(',') : 'trending,viral,controversial' }}",
        "categoryId": "25",
        "privacyStatus": "private",
        "binaryData": true,
        "binaryPropertyName": "video"
      },
